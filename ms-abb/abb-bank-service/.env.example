# Copy to .env (docker-compose reads it automatically) and fill in as needed.
# All of these already have working defaults in docker-compose.yml for local dev —
# you only need this file once you have real ABB credentials or want non-default DB creds.

DB_NAME=abb_bank_service
DB_USER=abb
DB_PASSWORD=abb
DB_PORT=5432

# Leave these empty until you have real sandbox/demo credentials from ABB.
ABB_API_BASE_URL=https://api-test-c2b.abb-bank.az
ABB_API_USERNAME=
ABB_API_PASSWORD=
